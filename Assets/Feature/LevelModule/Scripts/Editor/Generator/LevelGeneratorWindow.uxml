<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="LevelGeneratorWindow.uss" />
    <ui:VisualElement name="root" class="generator-window">
        <ui:VisualElement name="settings-panel" class="panel">
            <ui:Label text="Level Generator Settings" class="header" />
            <ui:ScrollView>
                <ui:VisualElement class="field-row">
                    <ui:Label text="Rings (Min/Max):" class="field-label" />
                    <uie:IntegerField name="minRings" value="3" class="field-input" />
                    <uie:IntegerField name="maxRings" value="6" class="field-input" />
                </ui:VisualElement>
                <ui:VisualElement class="field-row">
                    <ui:Label text="Areas (Min/Max):" class="field-label" />
                    <uie:IntegerField name="minAreas" value="1" class="field-input" />
                    <uie:IntegerField name="maxAreas" value="4" class="field-input" />
                </ui:VisualElement>
                <ui:VisualElement class="field-row">
                    <ui:Label text="Sectors (Min/Max):" class="field-label" />
                    <uie:IntegerField name="minSectors" value="4" class="field-input" />
                    <uie:IntegerField name="maxSectors" value="8" class="field-input" />
                </ui:VisualElement>
                <ui:VisualElement class="field-row">
                    <ui:Label text="Ring Span (Min/Max):" class="field-label" />
                    <uie:IntegerField name="minAreaSpan" value="2" class="field-input" />
                    <uie:IntegerField name="maxAreaSpan" value="4" class="field-input" />
                </ui:VisualElement>
                <ui:VisualElement class="field-row">
                    <ui:Label text="Target Difficulty:" class="field-label" />
                    <uie:IntegerField name="targetDifficulty" value="8" class="field-input" />
                </ui:VisualElement>

                <ui:Label text="Segment Constraints" class="subheader" />
                <ui:VisualElement class="field-row">
                    <ui:Label text="Allow Blocked:" class="field-label" />
                    <ui:Toggle name="allowBlocked" value="true" class="field-input" />
                </ui:VisualElement>
                <ui:VisualElement class="field-row">
                    <ui:Label text="Blocked Chance:" class="field-label" />
                    <ui:Slider name="blockedChance" low-value="0" high-value="0.5" value="0.1" class="field-input" />
                </ui:VisualElement>

                <ui:Label text="Arena Constraints" class="subheader" />
                <ui:VisualElement class="field-row">
                    <ui:Label text="Allow FilterColors:" class="field-label" />
                    <ui:Toggle name="allowFilterColors" value="true" class="field-input" />
                </ui:VisualElement>
                <ui:VisualElement class="field-row">
                    <ui:Label text="Filter Chance:" class="field-label" />
                    <ui:Slider name="filterChance" low-value="0" high-value="1" value="0.2" class="field-input" />
                </ui:VisualElement>
                <ui:VisualElement class="field-row">
                    <ui:Label text="Allowed Colors (Min/Max):" class="field-label" />
                    <uie:IntegerField name="minFilterColors" value="2" class="field-input" />
                    <uie:IntegerField name="maxFilterColors" value="3" class="field-input" />
                </ui:VisualElement>
            </ui:ScrollView>
            <ui:Button name="generateButton" text="Generate Level" class="primary-button" />
            <ui:Button name="cancelButton" text="Cancel Generation" class="cancel-button hidden" />
            <ui:Label name="progressLabel" text="" class="progress-label" />
        </ui:VisualElement>
        
        <ui:VisualElement name="preview-panel" class="panel preview-panel">
            <ui:Label text="Visual Preview" class="header" />
            <ui:VisualElement name="previewArea" class="preview-area" />
            <ui:Label name="statsLabel" text="Moves: - | Depth: -" class="stats-label" />
            <ui:VisualElement class="field-row" style="width: 100%; margin-top: 10px;">
                <ui:Label text="Level Name:" class="field-label" style="width: 80px;" />
                <ui:TextField name="levelName" value="LevelConfig_New" class="field-input" />
            </ui:VisualElement>
            <ui:Button name="saveButton" text="Save as LevelConfig" class="secondary-button" style="width: 100%;" />
        </ui:VisualElement>

        <ui:VisualElement name="browser-panel" class="panel">
            <ui:Label text="Level Browser" class="header" />
            <ui:ListView name="levelList" class="level-list" item-height="40" />
            <ui:Button name="refreshButton" text="Refresh List" class="secondary-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
