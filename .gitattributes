# Firebase SDK - large binaries
Assets/Firebase/Plugins/** filter=lfs diff=lfs merge=lfs -text
Assets/Firebase/m2repository/**/*.srcaar filter=lfs diff=lfs merge=lfs -text

# iOS/tvOS static libraries
Assets/Plugins/iOS/Firebase/** filter=lfs diff=lfs merge=lfs -text
Assets/Plugins/tvOS/Firebase/** filter=lfs diff=lfs merge=lfs -text

# GeneratedLocalRepo - large AARs
Assets/GeneratedLocalRepo/**/*.aar filter=lfs diff=lfs merge=lfs -text

# External dependency manager DLLs
Assets/ExternalDependencyManager/**/*.dll filter=lfs diff=lfs merge=lfs -text

# Firebase editor executables
Assets/Firebase/Editor/*.exe filter=lfs diff=lfs merge=lfs -text
